# Snapshot of production environment, plus defaults from internal/config/config.go.
GEAR_DB_PATH=/app/data/gear.db
GEAR_MASTER_KEY_PATH=/app/data/master.key
GEAR_TLS_CERT=/app/data/certs/cert.pem
GEAR_TLS_KEY=/app/data/certs/key.pem
GEAR_LISTEN_ADDR=:8443
GEAR_HTTP_ADDR=:8080
GEAR_REDIS_ADDR=redis:6379
GEAR_REDIS_PASSWORD=
GEAR_REDIS_DB=0
GEAR_CORS_ORIGIN=
GEAR_RATE_LIMIT_MAX=10
GEAR_RATE_LIMIT_WINDOW=5m
# Each admitted login reserves a slot; success releases only its own slot.
# Earlier failures and unfinished attempts remain until their window expires.
GEAR_LOGIN_FAIL_MAX=5
GEAR_LOGIN_FAIL_WINDOW=15m
GEAR_SESSION_TTL=12h
GEAR_TURNSTILE_ENABLED=true
GEAR_TURNSTILE_SECRET_FILE=
GEAR_TURNSTILE_TIMEOUT=5s
